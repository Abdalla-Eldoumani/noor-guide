{
  "name": "noor-guide",
  "version": "1.0.0",
  "private": true,
  "description": "Noor Guide: a nine-module guide to the basics of Islam for new Muslims.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "type-check": "tsc --noEmit",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:locales": "node scripts/verify-locales.mjs",
    "verify": "npm run verify:i18n && npm run verify:citations",
    "prebuild": "npm run verify",
    "fetch:scripture": "node scripts/fetch-scripture.mjs",
    "verify:citations": "node scripts/verify-citations.mjs"
  },
  "dependencies": {
    "lucide-react": "0.400.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.33",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
